{
  "name": "codemgr",
  "private": true,
  "version": "0.1.0",
  "description": "CodeMgr — 开发者工作流管理器",
  "license": "MIT",
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "pnpm --filter codemgr-app dev",
    "start": "electron app",
    "build": "pnpm --filter codemgr-app build && pnpm --filter codemgr-native build:electron",
    "build:app": "pnpm --filter codemgr-app vite:build",
    "bench": "pnpm --filter codemgr-native bench",
    "test:native": "pnpm --filter codemgr-native test"
  },
  "cmake-js": {
    "runtime": "electron",
    "runtimeVersion": "43.2.0",
    "arch": "x64"
  },
  "devDependencies": {
    "electron": "43.2.0"
  }
}
