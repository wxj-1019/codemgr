{
  "name": "codemgr-app",
  "version": "0.1.0",
  "private": true,
  "description": "CodeMgr Electron app shell + renderer",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
